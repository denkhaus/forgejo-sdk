{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "enabledManagers": ["gomod"],
  "packageRules": [
    {
      "description": "Configure updates for the Forgejo SDK in the forgejo directory",
      "matchManagers": ["gomod"],
      "matchPaths": ["forgejo/**"],
      "labels": ["dependencies", "go-sdk"],
      "stabilityDays": 3,
      "separateMinorPatch": true,
      "automerge": false
    }
  ]
}
